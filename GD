  'V1':'v1', 'V2':'v2', 'V3':'v3', 'V-ing':'v-ing', 'V-s':'v-s'
};

/* ---- 10b. State & Functions ---- */
const LIB_STATE = {
  search: '',
  category: 'all',
  selectedId: null,
  listExpanded: false,
  relatedExpanded: false
};
const LIB_INITIAL_LIST = 8;
let _lastFocusedBeforeLib = null;

function getGlossaryEntries() {
  return Object.values(GRAMMAR_GLOSSARY);
}
function getCategoryName(catId) {
  const c = GLOSSARY_CATEGORIES.find(c => c.id === catId);
  return c ? c.name : catId;
}
function filterGlossary() {
  const q = LIB_STATE.search.trim().toLowerCase();
  const cat = LIB_STATE.category;
  return getGlossaryEntries().filter(e => {
    if (cat !== 'all' && e.category !== cat) return false;
    if (!q) return true;
    const hay = [
      e.name, e.abbr || '', e.definition, e.fungsi || '',
      (e.identifikasi || ''), (e.rumus || ''),
      ...(e.contoh || []).map(c => c.kalimat + ' ' + c.catatan)
    ].join(' ').toLowerCase();
    return hay.includes(q);
  }).sort((a,b) => a.name.localeCompare(b.name));
}

function renderGlossaryCategories() {
  const el = document.getElementById('lib-cats');
  const cats = [{ id:'all', name:'Semua' }, ...GLOSSARY_CATEGORIES];
  el.innerHTML = cats.map(c => {
    const active = LIB_STATE.category === c.id ? ' active' : '';
    return `<button type="button" class="lib-cat${active}" data-cat="${esc(c.id)}"
      role="tab" aria-selected="${LIB_STATE.category === c.id}">${esc(c.name)}</button>`;
  }).join('');
}

function renderGlossaryList() {
  const list = document.getElementById('lib-list');
  const results = filterGlossary();
  if (!results.length) {
    list.innerHTML = `<div class="lib-empty">
      <strong>Tidak ada istilah yang cocok.</strong>
      Coba kata kunci lain atau ubah filter kategori.
    </div>`;
    return;
  }
  const expanded = LIB_STATE.listExpanded;
  const shown = expanded ? results : results.slice(0, LIB_INITIAL_LIST);
  const hiddenCount = results.length - Math.min(LIB_INITIAL_LIST, results.length);
  let html = shown.map(e => `
    <button type="button" class="lib-item" data-term="${esc(e.id)}">
      <div class="li-top">
        <span class="li-name">${esc(e.name)}</span>
        ${e.abbr ? `<span class="li-abbr">${esc(e.abbr)}</span>` : ''}
        <span class="li-cat">${esc(getCategoryName(e.category))}</span>
      </div>
      <div class="li-def">${esc(e.definition)}</div>
    </button>`).join('');
  if (hiddenCount > 0) {
    html += `<div style="text-align:center"><button class="view-more-btn" data-lib-expand="list">
      ${expanded ? 'View less' : `View more (${hiddenCount})`}
    </button></div>`;
  }
  list.innerHTML = html;
}

function renderGlossaryDetail(termId) {
  const e = GRAMMAR_GLOSSARY[termId];
  const detail = document.getElementById('lib-detail');
  if (!e) {
    detail.innerHTML = `<div class="lib-empty"><strong>Istilah tidak ditemukan.</strong></div>`;
    return;
  }
  const relatedEntries = (e.related || []).map(id => GRAMMAR_GLOSSARY[id]).filter(Boolean);
  const relLimit = 5;
  const relExpanded = LIB_STATE.relatedExpanded;
  const relShown = relExpanded ? relatedEntries : relatedEntries.slice(0, relLimit);
  const relHidden = relatedEntries.length - Math.min(relLimit, relatedEntries.length);

  let html = `<h3>${esc(e.name)}
    ${e.abbr ? `<span class="ld-abbr">${esc(e.abbr)}</span>` : ''}
    <span class="ld-cat">${esc(getCategoryName(e.category))}</span>
  </h3>`;

  html += `<div class="ld-section"><h4>Definisi</h4><p>${esc(e.definition)}</p></div>`;
  if (e.fungsi) html += `<div class="ld-section"><h4>Fungsi</h4><p>${esc(e.fungsi)}</p></div>`;
  if (e.identifikasi) html += `<div class="ld-section"><h4>Cara Mengenali</h4><p>${esc(e.identifikasi)}</p></div>`;
  if (e.rumus) html += `<div class="ld-section"><h4>Rumus / Pola</h4><div class="ld-formula">${esc(e.rumus)}</div></div>`;

  if (e.contoh && e.contoh.length) {
    html += `<div class="ld-section"><h4>Contoh</h4>`;
    e.contoh.forEach(c => {
      html += `<div class="ld-ex">
        <div class="ex-sent">${c.kalimat}</div>
        <div class="ex-note">${esc(c.catatan)}</div>
      </div>`;
    });
    html += `</div>`;
  }

  if (e.perbedaan) {
    html += `<div class="ld-section"><h4>Perbedaan dengan Istilah Lain</h4><p>${esc(e.perbedaan)}</p></div>`;
  }

  if (relatedEntries.length) {
    html += `<div class="ld-section"><h4>Istilah Terkait</h4><div class="ld-related">`;
    html += relShown.map(r =>
      `<button type="button" class="lib-related-btn" data-term="${esc(r.id)}">${esc(r.name)}</button>`
    ).join('');
    html += `</div>`;
    if (relHidden > 0) {
      html += `<div style="margin-top:8px"><button class="view-more-btn" data-lib-expand="related">
        ${relExpanded ? 'View less' : `View more (${relHidden})`}
      </button></div>`;
    }
    html += `</div>`;
  }

  detail.innerHTML = html;
}

function showGlossaryListView() {
  document.getElementById('lib-list-view').hidden = false;
  document.getElementById('lib-detail-view').hidden = true;
  LIB_STATE.selectedId = null;
}
function showGlossaryDetailView(termId) {
  if (!GRAMMAR_GLOSSARY[termId]) return;
  LIB_STATE.selectedId = termId;
  LIB_STATE.relatedExpanded = false;
  document.getElementById('lib-list-view').hidden = true;
  document.getElementById('lib-detail-view').hidden = false;
  renderGlossaryDetail(termId);
  const dv = document.getElementById('lib-detail-view');
  dv.scrollTop = 0;
}

function openGrammarLibrary(termId) {
  _lastFocusedBeforeLib = document.activeElement;
  const overlay = document.getElementById('lib-overlay');
  overlay.hidden = false;
  // Trigger reflow agar transisi jalan
  void overlay.offsetWidth;
  overlay.setAttribute('data-open', 'true');

  renderGlossaryCategories();
  renderGlossaryList();

  if (termId && GRAMMAR_GLOSSARY[termId]) {
    showGlossaryDetailView(termId);
  } else {
    showGlossaryListView();
  }

  // Fokus ke search input (atau ke tombol close jika di mobile)
  setTimeout(() => {
    const search = document.getElementById('lib-search');
    if (search) search.focus();
  }, 50);

  document.body.style.overflow = 'hidden';
}

function closeGrammarLibrary() {
  const overlay = document.getElementById('lib-overlay');
  overlay.setAttribute('data-open', 'false');
  setTimeout(() => {
    if (overlay.getAttribute('data-open') === 'false') overlay.hidden = true;
  }, 180);
  document.body.style.overflow = '';
  if (_lastFocusedBeforeLib && typeof _lastFocusedBeforeLib.focus === 'function') {
    try { _lastFocusedBeforeLib.focus(); } catch(_) {}
  }
}

function openGlossaryTerm(termId) {
  const overlay = document.getElementById('lib-overlay');
  const isOpen = overlay.getAttribute('data-open') === 'true';
  if (!isOpen) {
    openGrammarLibrary(termId);
  } else {
    showGlossaryDetailView(termId);
  }
}

function searchGlossary(q) {
  LIB_STATE.search = q;
  LIB_STATE.listExpanded = false;
  renderGlossaryList();
  // Ketika user mengetik, jika ada detail terbuka, kembali ke list agar hasil terlihat
  if (LIB_STATE.selectedId && q.trim()) showGlossaryListView();
}

/* ---- 10c. Event Binding Library ---- */
function initLibraryEvents() {
  document.getElementById('library').addEventListener('click', () => openGrammarLibrary());
  document.getElementById('lib-close').addEventListener('click', closeGrammarLibrary);
  document.getElementById('lib-overlay').addEventListener('mousedown', (e) => {
    if (e.target === document.getElementById('lib-overlay')) closeGrammarLibrary();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('lib-overlay').getAttribute('data-open') === 'true') {
      closeGrammarLibrary();
    }
  });

  document.getElementById('lib-search').addEventListener('input', (e) => searchGlossary(e.target.value));

  document.getElementById('lib-cats').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-cat]');
    if (!btn) return;
    LIB_STATE.category = btn.dataset.cat;
    LIB_STATE.listExpanded = false;
    renderGlossaryCategories();
    renderGlossaryList();
    showGlossaryListView();
  });

  document.getElementById('lib-list').addEventListener('click', (e) => {
    const expandBtn = e.target.closest('[data-lib-expand="list"]');
    if (expandBtn) {
      LIB_STATE.listExpanded = !LIB_STATE.listExpanded;
      renderGlossaryList();
      return;
    }
    const item = e.target.closest('[data-term]');
    if (item) showGlossaryDetailView(item.dataset.term);
  });

  document.getElementById('lib-detail-view').addEventListener('click', (e) => {
    if (e.target.closest('#lib-back')) { showGlossaryListView(); return; }
    const relExpand = e.target.closest('[data-lib-expand="related"]');
    if (relExpand) {
      LIB_STATE.relatedExpanded = !LIB_STATE.relatedExpanded;
      if (LIB_STATE.selectedId) renderGlossaryDetail(LIB_STATE.selectedId);
      return;
    }
    const item = e.target.closest('[data-term]');
    if (item) showGlossaryDetailView(item.dataset.term);
  });
}

/* ---- 10d. Integration: klik gloss-link di mana pun ---- */
document.addEventListener('click', (e) => {
  const el = e.target.closest('[data-gloss]');
  if (!el) return;
  e.preventDefault();
  openGlossaryTerm(el.dataset.gloss);
});

/* ---- 10e. Expand handler global (View more / less di panel utama) ---- */
document.addEventListener('click', (e) => {
  const btn = e.target.closest('[data-expand]');
  if (!btn) return;
  const id = btn.dataset.expand;
  EXPAND_STATE.set(id, !EXPAND_STATE.get(id));
  if (id === 'validation') renderValidation();
  else if (id === 'patterns') renderPatterns();
});

/* ============================================================
   BAGIAN 11: EVENT BINDING UTAMA
   ============================================================ */
const inputEl = document.getElementById('input');
function autoResizeInput() {
  inputEl.style.height = 'auto';
  inputEl.style.height = inputEl.scrollHeight + 'px';
}

document.getElementById('go').addEventListener('click', analyze);
document.getElementById('reset').addEventListener('click', () => {
  inputEl.value = '';
  autoResizeInput();
  STATE = Object.assign(STATE, {
    tokens: [], spans: [], structure: {}, grammar: [], issues: [], selected: null
  });
  EXPAND_STATE.clear();
  document.getElementById('output').innerHTML = '';
  document.getElementById('legend').innerHTML = '';
  document.getElementById('summary').innerHTML = `<h3>Ringkasan Struktur</h3><div class="muted">—</div>`;
  document.getElementById('detail').innerHTML = `<h3>Detail</h3><div class="muted">Klik sebuah kata atau frasa.</div>`;
  document.getElementById('validation').innerHTML = `<h3>Grammar Check</h3><div class="muted">—</div>`;
  document.getElementById('patterns').innerHTML = `<h3>Pola Grammar Terdeteksi</h3><div class="muted">—</div>`;
});

inputEl.addEventListener('input', autoResizeInput);
inputEl.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    analyze();
  }
});

document.getElementById('tabs').addEventListener('click', e => {
  const btn = e.target.closest('button[data-mode]');
  if (!btn) return;
  document.querySelectorAll('#tabs button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  STATE.mode = btn.dataset.mode;
  renderSentence();
  renderLegend();
});

document.getElementById('output').addEventListener('click', e => {
  const el = e.target.closest('.tok');
  if (!el) return;
  const idx = parseInt(el.dataset.idx, 10);
  STATE.selected = idx;
  renderSentence();
  renderDetail();
});

/* ============================================================
   INIT
   ============================================================ */
initLibraryEvents();
analyze();
autoResizeInput();
</script>
</body>
</html>