const ING_NOUNS = new Set(['morning','evening','thing','something','anything',
  'nothing','everything','king','ring','spring','string','ceiling','opening',
  'sibling','darling','offering','suffering']);

/* ============================================================
   BAGIAN 2: TOKENIZER
   ============================================================ */
function tokenize(text) {
  const raw = text.match(/[A-Za-z]+(?:'[A-Za-z]+)?|\d+(?:\.\d+)?|[.,!?;:()"\u2018\u2019\u201C\u201D]/g) || [];
  const out = [];
  for (const w of raw) {
    const lower = w.toLowerCase();
    if (C[lower]) {
      const parts = C[lower];
      parts.forEach((p, i) => out.push(Object.assign({}, p, {
        raw: w, contStart: i === 0, contEnd: i === parts.length - 1, isCont: true
      })));
    } else {
      out.push({ text: w, raw: w, tag: null, lemma: null, form: null,
                 contStart: true, contEnd: true, isCont: false });
    }
  }
  return out;
}

/* ============================================================
   BAGIAN 3: TAGGER
   ============================================================ */
function isVerbWord(w) {
  const lw = w.toLowerCase();
  const e = LEX[lw];
  if (!e) return !!IRREG[lw];
  if (/^VB/.test(e.t)) return true;
  if (e.amb && e.amb.includes('VB')) return true;
  return false;
}
function stemS(w) {
  if (w.endsWith('ies')) return w.slice(0, -3) + 'y';
  if (w.endsWith('es'))  return w.slice(0, -2);
  return w.slice(0, -1);
}
function stemEd(w) {
  if (w.endsWith('ied')) return w.slice(0, -3) + 'y';
  if (w.endsWith('ed')) {
    let s = w.slice(0, -2);
    if (s.length >= 2 && s[s.length-1] === s[s.length-2] && !/[aeiou]/.test(s[s.length-1])) s = s.slice(0, -1);
    return s;
  }
  return w;
}
function stemIng(w) {
  let s = w.slice(0, -3);
  if (s.length >= 2 && s[s.length-1] === s[s.length-2] && !/[aeiou]/.test(s[s.length-1])) s = s.slice(0, -1);
  if (s.length >= 3 && !/[aeiou]$/.test(s)) {
    const guess = s + 'e';
    if (LEX[guess]) return guess;
  }
  return s;
}
function tagOne(tokens, i) {
  const t = tokens[i];
  if (t.tag) return;
  const raw = t.text;
  const w = raw.toLowerCase();
  const prev = i > 0 ? tokens[i-1] : null;
  const next = i < tokens.length-1 ? tokens[i+1] : null;
  const prevTag = prev ? prev.tag : null;

  if (/^[.,!?;:()"\u2018\u2019\u201C\u201D]$/.test(raw)) { t.tag = 'PUNCT'; return; }
  if (/^\d/.test(raw)) { t.tag = 'CD'; t.lemma = raw; return; }

  if (w === 'to') {
    const nextVerbish = next && (isVerbWord(next.text) || IRREG[next.text.toLowerCase()]);
    if (nextVerbish) { t.tag = 'TO'; t.lemma = 'to'; }
    else { t.tag = 'IN'; t.lemma = 'to'; t.toPrep = true; }
    return;
  }
  if (w === 'that') {
    const nextIsNounish = next && /^(NN|NNS|NNP|JJ|DT|CD)$/.test(next.tag || LEX[next.text.toLowerCase()]?.t || '');
    if (nextIsNounish) { t.tag = 'DT'; t.lemma = 'that'; }
    else { t.tag = 'IN'; t.lemma = 'that'; t.amb = ['DT','PRP']; }
    return;
  }
  if (w === 'her' || w === 'his') {
    const nextIsNounish = next && /^(NN|NNS|NNP|JJ)$/.test(next.tag || LEX[next.text.toLowerCase()]?.t || '');
    if (nextIsNounish) { t.tag = 'PRP$'; t.lemma = w; }
    else { t.tag = 'PRP'; t.lemma = w; }
    return;
  }
  if (w === 'like') {
    const prevIsAux = prev && (prev.aux || /^(MD)$/.test(prevTag||''));
    const prevIsSubject = prev && /^(PRP|NN|NNP|NNS)$/.test(prevTag||'') && !(next && next.tag === 'PUNCT');
    if (prevTag === 'TO' || prevIsAux || prevIsSubject) {
      t.tag = 'VB'; t.lemma = 'like'; t.form = 'V1'; t.amb = ['IN'];
    } else { t.tag = 'IN'; t.lemma = 'like'; t.amb = ['VB']; }
    return;
  }
  if (w === 'fast' || w === 'hard' || w === 'late' || w === 'early' || w === 'far') {
    const prevIsBe = prev && prev.lemma === 'be';
    const nextIsNounish = next && /^(NN|NNS|NNP)$/.test(next.tag || LEX[next.text.toLowerCase()]?.t || '');
    if (prevIsBe || nextIsNounish) { t.tag = 'JJ'; t.lemma = w; t.amb = ['RB']; }
    else { t.tag = 'RB'; t.lemma = w; t.amb = ['JJ']; }
    return;
  }

  const lexEntry = LEX[w];
  if (lexEntry) {
    t.tag = lexEntry.t;
    t.lemma = lexEntry.lemma || w;
    t.form = lexEntry.form;
    if (lexEntry.aux) t.aux = true;
    if (lexEntry.person) t.person = lexEntry.person;
    if (lexEntry.num) t.num = lexEntry.num;
    if (lexEntry.amb) t.amb = lexEntry.amb.slice();
    if (t.amb && t.amb.includes('VB')) {
      const afterAux = prev && (prev.aux || prevTag === 'MD' || prevTag === 'TO');
      const afterSubject = prev && /^(PRP)$/.test(prevTag||'') && !(next && next.tag === 'PUNCT');
      if (afterAux || afterSubject) { t.tag = 'VB'; t.form = 'V1'; }
    }
    return;
  }
  if (IRREG[w]) {
    t.tag = IRREG[w].tag; t.lemma = IRREG[w].lemma; t.form = IRREG[w].form;
    if (IRREG[w].amb) t.amb = IRREG[w].amb.slice();
    return;
  }
  if (prevTag === 'MD') { t.tag = 'VB'; t.lemma = w; t.form = 'V1'; return; }
  if (w.length > 4 && w.endsWith('ing')) {
    const isNounCtx = prevTag === 'DT' || prevTag === 'PRP$' || prevTag === 'JJ';
    if (ING_NOUNS.has(w)) { t.tag = 'NN'; t.lemma = w; }
    else {
      t.tag = 'VBG'; t.lemma = stemIng(w); t.form = 'V-ing';
      if (isNounCtx) t.amb = ['NN'];
    }
    return;
  }
  if (w.length > 4 && w.endsWith('ed')) {
    const prevIsHave = prev && prev.lemma === 'have';
    const prevIsBe   = prev && prev.lemma === 'be';
    if (prevIsHave || prevIsBe) { t.tag = 'VBN'; t.form = 'V3'; t.lemma = stemEd(w); }
    else { t.tag = 'VBD'; t.form = 'V2'; t.lemma = stemEd(w); t.amb = ['VBN','JJ']; }
    return;
  }
  if (w.length > 2 && w.endsWith('s') && !w.endsWith('ss') && !w.endsWith('us') && !w.endsWith('is')) {
    const stem = stemS(w);
    const stemEntry = LEX[stem];
    if (stemEntry && /^VB/.test(stemEntry.t)) { t.tag = 'VBZ'; t.form = 'V-s'; t.lemma = stem; return; }
    if (IRREG[stem] && /V[BD]/.test(IRREG[stem].tag)) { t.tag = 'VBZ'; t.form = 'V-s'; t.lemma = stem; return; }
    if (stemEntry && /^NN/.test(stemEntry.t)) { t.tag = 'NNS'; t.lemma = stem; return; }
    t.tag = 'NNS'; t.lemma = stem; t.amb = ['VBZ'];
    return;
  }
  if (w.length > 4 && w.endsWith('ly')) { t.tag = 'RB'; t.lemma = w; return; }
  if (w.length > 5 && w.endsWith('est')) { t.tag = 'JJS'; t.lemma = w; return; }
  if (w.length > 4 && w.endsWith('er') && w.length <= 6) { t.tag = 'JJR'; t.lemma = w; t.amb = ['NN']; return; }
  if (w.length > 4 && /(tion|sion|ment|ness|ity|ance|ence|ship|hood|dom|ism)$/.test(w)) { t.tag = 'NN'; t.lemma = w; return; }
  if (w.length > 4 && /(ful|ous|ive|able|ible|ical|ic|al)$/.test(w)) { t.tag = 'JJ'; t.lemma = w; return; }

  if (prevTag === 'DT' || prevTag === 'PRP$') { t.tag = 'NN'; t.lemma = w; return; }
  if (prevTag === 'TO')  { t.tag = 'VB'; t.lemma = w; t.form = 'V1'; return; }
  if (prevTag === 'CC')  { t.tag = 'NN'; t.lemma = w; return; }
  if (prevTag === 'IN')  { t.tag = 'NN'; t.lemma = w; return; }
  if (prevTag === 'JJ')  { t.tag = 'NN'; t.lemma = w; return; }

  t.tag = 'NN'; t.lemma = w; t.unknown = true;
}

function markAux(tokens) {
  for (let i = 0; i < tokens.length; i++) {
    const t = tokens[i];
    if (t.tag === 'MD') { t.aux = true; continue; }
    if (t.lemma === 'be' || t.lemma === 'do' || t.lemma === 'have') {
      let j = i + 1;
      while (j < tokens.length && tokens[j].tag === 'RB' && tokens[j].lemma === 'not') j++;
      if (j < tokens.length && /^(VB|VBD|VBG|VBN|VBP|VBZ)$/.test(tokens[j].tag)) t.aux = true;
      else t.aux = false;
    } else { t.aux = false; }
  }
}
function tagAll(tokens) {
  for (let i = 0; i < tokens.length; i++) tagOne(tokens, i);
  markAux(tokens);
}

/* ============================================================
   BAGIAN 4: PHRASE CHUNKER
   ============================================================ */
function detectNP(tokens, i) {
  let j = i, hasHead = false;
  if (tokens[j] && (tokens[j].tag === 'DT' || tokens[j].tag === 'PRP$')) j++;
  while (tokens[j] && /^(JJ|JJR|JJS|CD)$/.test(tokens[j].tag)) j++;
  if (tokens[j] && /^(NN|NNS|NNP|PRP)$/.test(tokens[j].tag)) { hasHead = true; j++; }
  if (!hasHead) return null;
  return { start: i, end: j - 1 };
}
function chunk(tokens) {
  const spans = [];
  let i = 0;
  while (i < tokens.length) {
    const t = tokens[i];
    if (t.tag === 'PUNCT' || t.tag === 'CC') { i++; continue; }

    if (t.tag === 'IN') {
      const np = detectNP(tokens, i + 1);
      const afterNP = np ? tokens[np.end + 1] : null;
      const isSubordinator = afterNP && /^(VBP|VBZ|VBD|MD)$/.test(afterNP.tag);
      if (np && !isSubordinator) {
        spans.push({ start: i, end: np.end, type: 'PP', label: 'Prepositional Phrase' });
        i = np.end + 1; continue;
      }
    }
    if (t.tag === 'TO') {
      let j = i + 1;
      while (j < tokens.length && /^(VB|VBP|VBZ)$/.test(tokens[j].tag)) j++;
      const np = detectNP(tokens, j);
      if (np) j = np.end + 1;
      if (j > i + 1) {
        spans.push({ start: i, end: j - 1, type: 'InfP', label: 'Infinitive Phrase' });
        i = j; continue;
      }
    }
    if (t.tag === 'VBG') {
      let j = i + 1;
      const np = detectNP(tokens, j);
      if (np) j = np.end + 1;
      spans.push({ start: i, end: j - 1, type: 'GerP', label: 'Gerund Phrase' });
      i = j; continue;
    }
    if (/^(MD|VB|VBD|VBG|VBN|VBP|VBZ)$/.test(t.tag)) {
      let j = i;
      while (j < tokens.length) {
        if (/^(MD|VB|VBD|VBG|VBN|VBP|VBZ)$/.test(tokens[j].tag)) j++;
        else if (tokens[j].tag === 'RB' && tokens[j].lemma === 'not') j++;
        else break;
      }
      if (j > i) {
        spans.push({ start: i, end: j - 1, type: 'VP', label: 'Verb Phrase' });
        i = j; continue;
      }
    }
    const np = detectNP(tokens, i);
    if (np) {
      spans.push(Object.assign({ label: 'Noun Phrase' }, np, { type: 'NP' }));
      i = np.end + 1; continue;
    }
    if (/^(JJ|JJR|JJS)$/.test(t.tag)) {
      let j = i;
      while (j < tokens.length && /^(JJ|JJR|JJS)$/.test(tokens[j].tag)) j++;
      spans.push({ start: i, end: j - 1, type: 'AdjP', label: 'Adjective Phrase' });
      i = j; continue;
    }
    if (t.tag === 'RB') {
      let j = i;
      while (j < tokens.length && tokens[j].tag === 'RB') j++;
      spans.push({ start: i, end: j - 1, type: 'AdvP', label: 'Adverb Phrase' });
      i = j; continue;
    }
    i++;
  }
  return spans;
}

/* ============================================================
   BAGIAN 5: STRUKTUR KALIMAT
   ============================================================ */
function analyzeStructure(tokens, spans) {
  const vpSpans = spans.filter(s => s.type === 'VP');
  if (vpSpans.length === 0) return { vps: [], subject: null, object: null, adverbials: [] };
  const vp = vpSpans[0];
  let sStart = 0, sEnd = vp.start - 1;
  while (sStart <= sEnd && /^(RB|CC|UH)$/.test(tokens[sStart].tag)) sStart++;
  while (sEnd >= sStart && /^(RB|CC|UH)$/.test(tokens[sEnd].tag)) sEnd--;
  const subject = sEnd >= sStart ? { start: sStart, end: sEnd } : null;
  const ppSpans = spans.filter(s => s.type === 'PP');
  const insidePP = sp => ppSpans.some(p => sp.start > p.start && sp.end <= p.end);
  const object = spans.find(s => s.start > vp.end && s.type === 'NP' && !insidePP(s)) || null;
  const adverbials = spans.filter(s => s.start > vp.end && (s.type === 'PP' || s.type === 'AdvP'));
  return { vps: vpSpans, vp, subject, object, adverbials };
}

/* ============================================================
   BAGIAN 6: TENSE DETECTOR
   ============================================================ */
function detectTenseForVP(tokens, vp) {
  const verbs = [];
  for (let i = vp.start; i <= vp.end; i++) {
    if (/^(MD|VB|VBD|VBG|VBN|VBP|VBZ)$/.test(tokens[i].tag)) verbs.push(tokens[i]);
  }
  if (verbs.length === 0) return null;
  const lemmas = verbs.map(v => v.lemma);
  const tags = verbs.map(v => v.tag);

  if (lemmas[0] === 'have' && verbs.length >= 3 && lemmas[1] === 'be' && tags[2] === 'VBG') {
    return tags[0] === 'VBD'
      ? { name:'Past Perfect Continuous', formula:'had + been + V-ing', span:vp, glossId:'past-perfect-continuous' }
      : { name:'Present Perfect Continuous', formula:'have/has + been + V-ing', span:vp, glossId:'present-perfect-continuous' };
  }
  if (lemmas[0] === 'have' && tags[1] === 'VBN') {
    return tags[0] === 'VBD'
      ? { name:'Past Perfect', formula:'had + V3', span:vp, glossId:'past-perfect' }
      : { name:'Present Perfect', formula:'have/has + V3', span:vp, glossId:'present-perfect' };
  }
  if (lemmas[0] === 'be' && tags[1] === 'VBG') {
    return tags[0] === 'VBD'
      ? { name:'Past Continuous', formula:'was/were + V-ing', span:vp, glossId:'past-continuous' }
      : { name:'Present Continuous', formula:'am/is/are + V-ing', span:vp, glossId:'present-continuous' };
  }
  if (lemmas[0] === 'be' && tags[1] === 'VBN') {
    return tags[0] === 'VBD'
      ? { name:'Simple Past (Passive)', formula:'was/were + V3', span:vp, glossId:'passive-voice' }
      : { name:'Simple Present (Passive)', formula:'am/is/are + V3', span:vp, glossId:'passive-voice' };
  }
  if (tags[0] === 'MD' && (lemmas[0] === 'will' || lemmas[0] === 'shall')
      && verbs.length >= 3 && lemmas[1] === 'have' && tags[2] === 'VBN') {
    return { name:'Future Perfect', formula:'will + have + V3', span:vp, glossId:'future-perfect' };
  }
  if (tags[0] === 'MD' && (lemmas[0] === 'will' || lemmas[0] === 'shall')
      && verbs.length >= 3 && lemmas[1] === 'be' && tags[2] === 'VBG') {
    return { name:'Future Continuous', formula:'will + be + V-ing', span:vp, glossId:'future-continuous' };
  }
  if (tags[0] === 'MD' && (lemmas[0] === 'will' || lemmas[0] === 'shall')
      && verbs.length >= 4 && lemmas[1] === 'have' && lemmas[2] === 'be' && tags[3] === 'VBG') {
    return { name:'Future Perfect Continuous', formula:'will + have + been + V-ing', span:vp, glossId:'future-perfect-continuous' };
  }
  if (tags[0] === 'MD' && (lemmas[0] === 'will' || lemmas[0] === 'shall')
      && verbs.length >= 2 && tags[1] === 'VB') {
    return { name:'Simple Future', formula:'will + V1', span:vp, glossId:'simple-future' };
  }
  if (lemmas[0] === 'do' && verbs.length >= 2 && tags[1] === 'VB') {
    return { name:'Simple Present', formula:'do/does + V1 (negation/question)', span:vp, glossId:'negation' };
  }
  if (lemmas[0] === 'do' && tags[0] === 'VBD' && verbs.length >= 2 && tags[1] === 'VB') {
    return { name:'Simple Past', formula:'did + V1 (negation/question)', span:vp, glossId:'negation' };
  }
  if (tags[0] === 'MD' && verbs.length >= 2 && tags[1] === 'VB') {
    return { name:'Modal Construction', formula:'modal + V1', span:vp, glossId:'modal-construction' };
  }
  if (tags[0] === 'VBD') return { name:'Simple Past', formula:'S + V2', span:vp, glossId:'simple-past' };
  if (tags[0] === 'VBP' || tags[0] === 'VBZ') {
    return { name:'Simple Present', formula:'S + V1/V-s', span:vp, glossId:'simple-present' };
  }
  if (tags[0] === 'VB') return { name:'Simple Present', formula:'S + V1', span:vp, glossId:'simple-present' };
  if (lemmas[0] === 'be') {
    return tags[0] === 'VBD'
      ? { name:'Simple Past (copula)', formula:'was/were + complement', span:vp, glossId:'copular-verb' }
      : { name:'Simple Present (copula)', formula:'am/is/are + complement', span:vp, glossId:'copular-verb' };
  }
  return null;
}
function detectGrammar(tokens, spans) {
  const results = [];
  spans.filter(s => s.type === 'VP').forEach(vp => {
    const r = detectTenseForVP(tokens, vp);
    if (r) results.push(r);
  });
  return results;
}

/* ============================================================
   BAGIAN 7: VALIDATOR
   ============================================================ */
function validate(tokens, structure) {
  const issues = [];
  if (structure.subject && structure.vp) {
    const subjTokens = tokens.slice(structure.subject.start, structure.subject.end + 1);
    const lastSubj = subjTokens[subjTokens.length - 1];
    let is3sg = false;
    if (lastSubj && lastSubj.tag === 'PRP') {
      if (['he','she','it'].includes(lastSubj.text.toLowerCase())) is3sg = true;
    } else if (lastSubj && /^(NN|NNP)$/.test(lastSubj.tag)) is3sg = true;

    const vpTokens = tokens.slice(structure.vp.start, structure.vp.end + 1);
    const mainVerb = vpTokens.filter(t => /^(VB|VBD|VBG|VBN|VBP|VBZ)$/.test(t.tag)).pop();
    const hasModal = vpTokens.some(t => t.tag === 'MD');
    const hasAux = vpTokens.some(t => (t.aux || t.tag === 'MD'));

    if (mainVerb && !hasModal) {
      if (mainVerb.tag === 'VBZ' && !is3sg && !hasAux) {
        issues.push({ level:'error', glossId:'subject-verb-agreement',
          msg:`Subject-verb agreement: subject bukan orang ketiga tunggal, tetapi verb "${mainVerb.text}" berbentuk V-s. Seharusnya V1.` });
      }
      if ((mainVerb.tag === 'VBP' || mainVerb.tag === 'VB') && is3sg && !hasAux) {
        issues.push({ level:'error', glossId:'subject-verb-agreement',
          msg:`Subject-verb agreement: subject orang ketiga tunggal, tetapi verb "${mainVerb.text}" berbentuk V1. Seharusnya V-s.` });
      }
    }
  }
  for (let i = 0; i < tokens.length - 1; i++) {
    if (tokens[i].tag === 'MD') {
      let j = i + 1;
      while (j < tokens.length && tokens[j].tag === 'RB' && tokens[j].lemma === 'not') j++;
      const v = tokens[j];
      if (v && /^(VB|VBD|VBG|VBN|VBP|VBZ)$/.test(v.tag) && v.tag !== 'VB') {
        issues.push({ level:'error', glossId:'modal-verb',
          msg:`Setelah modal "${tokens[i].text}" harus V1 (base form), bukan "${v.text}".` });
      }
    }
  }
  for (let i = 0; i < tokens.length - 1; i++) {
    const t = tokens[i];
    if (t.lemma === 'do' && t.aux) {
      let j = i + 1;
      while (j < tokens.length && tokens[j].tag === 'RB' && tokens[j].lemma === 'not') j++;
      const v = tokens[j];
      if (v && /^(VB|VBD|VBG|VBN|VBP|VBZ)$/.test(v.tag) && v.tag !== 'VB') {
        issues.push({ level:'error', glossId:'auxiliary-verb',
          msg:`Setelah auxiliary "${t.text}" harus V1, bukan "${v.text}".` });
      }
    }
  }
  for (let i = 0; i < tokens.length - 1; i++) {
    const t = tokens[i];
    if (t.lemma === 'have' && t.aux) {
      let j = i + 1;
      while (j < tokens.length && tokens[j].tag === 'RB' && tokens[j].lemma === 'not') j++;
      const v = tokens[j];
      if (v && /^(VB|VBD|VBG|VBN|VBP|VBZ)$/.test(v.tag) && v.tag !== 'VBN' && v.tag !== 'VBG' && v.tag !== 'VB') {
        issues.push({ level:'error', glossId:'v3',
          msg:`Setelah have/has/had harus V3, bukan "${v.text}".` });
      }
    }
  }
  for (let i = 0; i < tokens.length - 1; i++) {
    const t = tokens[i];
    if (t.lemma === 'be' && t.aux) {
      let j = i + 1;
      while (j < tokens.length && tokens[j].tag === 'RB' && tokens[j].lemma === 'not') j++;
      const v = tokens[j];
      if (v && /^(VB|VBD|VBG|VBN|VBP|VBZ)$/.test(v.tag) && v.tag !== 'VBG' && v.tag !== 'VBN') {
        issues.push({ level:'error', glossId:'auxiliary-verb',
          msg:`Setelah be harus V-ing (continuous) atau V3 (passive), bukan "${v.text}".` });
      }
    }
  }
  for (let i = 0; i < tokens.length - 1; i++) {
    const t = tokens[i];
    const next = tokens[i+1];
    if (t.tag === 'DT' && (t.text.toLowerCase() === 'a' || t.text.toLowerCase() === 'an')) {
      if (/^[A-Za-z]/.test(next.text)) {
        const startsVowel = /^[aeiou]/i.test(next.text);
        if (t.text.toLowerCase() === 'a' && startsVowel) {
          issues.push({ level:'warn', glossId:'determiner',
            msg:`Gunakan "an" sebelum "${next.text}" (dimulai dengan bunyi vokal).` });
        }
        if (t.text.toLowerCase() === 'an' && !startsVowel) {
          issues.push({ level:'warn', glossId:'determiner',
            msg:`Gunakan "a" sebelum "${next.text}" (bukan bunyi vokal).` });
        }
      }
    }
  }
  if (issues.length === 0) {
    issues.push({ level:'info', msg:'Tidak ada masalah grammar yang terdeteksi pada pemeriksaan dasar.' });
  }
  return issues;
}

/* ============================================================
   BAGIAN 8: PENJELASAN
   ============================================================ */
const TAG_LABEL = {
  NN:'Noun (singular)', NNS:'Noun (plural)', NNP:'Proper noun',
  PRP:'Pronoun', PRP$:'Possessive determiner',
  VB:'Verb (base)', VBD:'Verb (past / V2)', VBG:'Verb (V-ing)',
  VBN:'Verb (past participle / V3)', VBP:'Verb (base / non-3sg)',
  VBZ:'Verb (3rd person singular)',
  MD:'Modal verb', JJ:'Adjective', JJR:'Adjective (comparative)',
  JJS:'Adjective (superlative)', RB:'Adverb', DT:'Determiner',
  IN:'Preposition / subordinator', CC:'Coordinating conjunction',
  TO:'Infinitive marker', CD:'Numeral', UH:'Interjection',
  WP:'Wh-pronoun', WP$:'Wh-possessive', WDT:'Wh-determiner',
  WRB:'Wh-adverb', PUNCT:'Punctuation'
};

function wordFunction(idx, tokens, spans, structure) {
  const span = spans.find(s => idx >= s.start && idx <= s.end);
  let phraseRole = null, phraseGloss = null;
  if (span && span.type === 'VP' && structure.vp && span.start === structure.vp.start) {
    phraseRole = 'Predicate (Verb Phrase)'; phraseGloss = 'predicate';
  }
  else if (span && span.type === 'NP') {
    if (structure.subject && span.start === structure.subject.start && span.end === structure.subject.end) {
      phraseRole = 'Subject'; phraseGloss = 'subject';
    } else if (structure.object && span.start === structure.object.start) {
      phraseRole = 'Object'; phraseGloss = 'direct-object';
    } else { phraseRole = 'Noun Phrase'; phraseGloss = 'noun-phrase'; }
  }
  else if (span && span.type === 'PP')  { phraseRole = 'Adverbial / Prepositional'; phraseGloss = 'prepositional-phrase'; }
  else if (span && span.type === 'InfP'){ phraseRole = 'Infinitive phrase'; phraseGloss = 'infinitive-phrase'; }
  else if (span && span.type === 'GerP'){ phraseRole = 'Gerund phrase'; phraseGloss = 'gerund-phrase'; }
  else if (span && span.type === 'AdvP'){ phraseRole = 'Adverbial'; phraseGloss = 'adverb-phrase'; }
  else if (span && span.type === 'AdjP'){ phraseRole = 'Adjective Phrase'; phraseGloss = 'adjective-phrase'; }

  const tenseSpans = structure.grammar || [];
  const tense = tenseSpans.find(g => idx >= g.span.start && idx <= g.span.end);
  return { phraseRole, phraseGloss, span, tense };
}

function explainWord(idx, tokens, spans, structure) {
  const t = tokens[idx];
  const info = { text: t.raw, tag: t.tag, lemma: t.lemma, form: t.form };
  let reason = '';
  if (t.isCont) reason = `Bagian dari kontraksi "${t.raw}".`;
  else if (t.amb && t.amb.length) reason = `Memiliki kemungkinan tag lain: ${t.amb.join(', ')}. Konteks memilih "${t.tag}".`;
  else reason = `Lexicon / morfologi / urutan kata menetapkan tag "${t.tag}".`;
  let form = t.form;
  if (!form && /^VB/.test(t.tag)) {
    if (t.tag === 'VBD') form = 'V2';
    else if (t.tag === 'VBN') form = 'V3';
    else if (t.tag === 'VBG') form = 'V-ing';
    else if (t.tag === 'VBZ') form = 'V1 + s';
    else if (t.tag === 'VBP') form = 'V1';
  }
  return Object.assign(info, {
    label: TAG_LABEL[t.tag] || t.tag,
    form, aux: t.aux, reason, ambiguous: t.amb || []
  });
}

/* ============================================================
   BAGIAN 9: RENDERER
   ============================================================ */
const POS_COLORS = {
  NN:'#e8d9ff', NNS:'#e8d9ff', NNP:'#dcd0ff',
  PRP:'#d6ecff', PRP$:'#cfe2ff',
  VB:'#d4f5d4', VBD:'#ffe0e0', VBG:'#d0f0f5', VBN:'#c4e4c4',
  VBP:'#d4f5d4', VBZ:'#aee6ae',
  MD:'#fff2b8', JJ:'#ffe0e0', JJR:'#ffd0d0', JJS:'#ffc0c0',
  RB:'#ffe8cc', DT:'#f0f0f0', IN:'#ffd9a8', CC:'#f5e6b8',
  TO:'#ffd9a8', CD:'#e0e0e0', UH:'#ffcccc',
  WP:'#d6ecff', WDT:'#d6ecff', WRB:'#ffe8cc', WP$:'#cfe2ff'
};
const PHRASE_COLORS = {
  NP:'#e8d9ff', VP:'#d4f5d4', PP:'#ffd9a8',
  AdjP:'#ffe0e0', AdvP:'#ffe8cc',
  InfP:'#fff2b8', GerP:'#d0f0f5', PartP:'#d0f0f5'
};
const TENSE_COLORS = {
  'Simple Present':'#d4f5d4', 'Simple Past':'#ffe0e0', 'Simple Future':'#d0f0f5',
  'Present Continuous':'#d6ecff', 'Past Continuous':'#c0dcf0', 'Future Continuous':'#b8d4e8',
  'Present Perfect':'#d0f0f5', 'Past Perfect':'#c0e0e5', 'Future Perfect':'#b0d0d5',
  'Present Perfect Continuous':'#e0f8f8', 'Past Perfect Continuous':'#d0e8e8',
  'Future Perfect Continuous':'#c0d8d8', 'Modal Construction':'#fff2b8',
  'Simple Present (Passive)':'#ffd0e0', 'Simple Past (Passive)':'#ffd0e0',
  'Simple Present (copula)':'#d4f5d4', 'Simple Past (copula)':'#ffe0e0'
};

function esc(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}

let STATE = {
  tokens: [], spans: [], structure: {}, grammar: [],
  issues: [], mode: 'pos', selected: null
};

function colorForToken(idx, tokens, spans, grammar, mode) {
  if (mode === 'pos') return POS_COLORS[tokens[idx].tag] || null;
  if (mode === 'phrase') {
    const s = spans.find(sp => idx >= sp.start && idx <= sp.end);
    return s ? PHRASE_COLORS[s.type] : null;
  }
  if (mode === 'grammar') {
    const g = grammar.find(g => idx >= g.span.start && idx <= g.span.end);
    return g ? (TENSE_COLORS[g.name] || '#e0e0e0') : null;
  }
  return null;
}
function renderSentence() {
  const out = document.getElementById('output');
  const { tokens, spans, grammar, mode } = STATE;
  out.innerHTML = tokens.map((t, i) => {
    const bg = colorForToken(i, tokens, spans, grammar, mode);
    const style = bg ? `background:${bg};` : '';
    const cls = ['tok'];
    if (t.contEnd && !t.contStart) cls.push('cont-mid');
    if (!t.contEnd && t.contStart) cls.push('cont-mid');
    if (STATE.selected === i) cls.push('selected');
    const title = `title="${esc((TAG_LABEL[t.tag]||t.tag) + (t.lemma? ' · '+t.lemma : ''))}"`;
    return `<span class="${cls.join(' ')}" data-idx="${i}" style="${style}" ${title}>${esc(t.text)}</span>`;
  }).join(' ');
}
function renderLegend() {
  const legend = document.getElementById('legend');
  const mode = STATE.mode;
  let entries = [];
  if (mode === 'pos') {
    const used = new Set(STATE.tokens.filter(t=>t.tag!=='PUNCT').map(t=>t.tag));
    entries = [...used].map(tag => ({ label: TAG_LABEL[tag]||tag, color: POS_COLORS[tag]||'#eee' }));
  } else if (mode === 'phrase') {
    const used = new Set(STATE.spans.map(s=>s.type));
    entries = [...used].map(type => ({ label: type, color: PHRASE_COLORS[type]||'#eee' }));
  } else {
    const used = new Map();
    STATE.grammar.forEach(g => used.set(g.name, TENSE_COLORS[g.name]||'#eee'));
    entries = [...used].map(([label, color]) => ({ label, color }));
  }
  legend.innerHTML = entries.map(e =>
    `<span class="legend-item"><span class="swatch" style="background:${e.color}"></span>${esc(e.label)}</span>`
  ).join('');
}

/* ====== View more / less ====== */
const EXPAND_STATE = new Map();

function renderExpandable(containerId, items, renderItem, initial = 3, emptyHtml = '') {
  const el = document.getElementById(containerId);
  if (!el) return;
  if (!items.length) { el.innerHTML = emptyHtml || '<div class="muted">—</div>'; return; }
  const expanded = EXPAND_STATE.get(containerId) === true;
  const shown = expanded ? items : items.slice(0, initial);
  const hiddenCount = items.length - Math.min(initial, items.length);
  let html = shown.map(renderItem).join('');
  if (hiddenCount > 0) {
    html += `<div><button class="view-more-btn" data-expand="${containerId}" aria-expanded="${expanded}">${
      expanded ? 'View less' : `View more (${hiddenCount})`
    }</button></div>`;
  }
  el.innerHTML = html;
}

/* ====== Render panes ====== */
function glossLink(id, text) {
  if (!id) return esc(text);
  return `<button type="button" class="gloss-link" data-gloss="${esc(id)}">${esc(text)}</button>`;
}

function renderSummary() {
  const el = document.getElementById('summary');
  const s = STATE.structure;
  const tokens = STATE.tokens;
  const rows = [];
  const txt = (span) => span ? tokens.slice(span.start, span.end + 1).map(t=>t.text).join(' ') : '—';

  rows.push(['Subject', txt(s.subject), s.subject ? 'subject' : null]);

  if (s.vp) {
    rows.push(['Predicate', txt(s.vp), 'predicate']);
    const vpTokens = tokens.slice(s.vp.start, s.vp.end + 1).filter(t => /^VB/.test(t.tag));
    const main = vpTokens[vpTokens.length - 1];
    rows.push(['Main verb', main ? `${main.text} (${main.lemma || main.text})` : '—', 'main-verb']);
    const auxes = vpTokens.slice(0, -1).map(t=>t.text).join(' ');
    if (auxes) rows.push(['Auxiliary', auxes, 'auxiliary-verb']);
  }
  rows.push(['Object / Complement', txt(s.object), s.object ? 'direct-object' : null]);

  if (s.adverbials && s.adverbials.length) {
    rows.push(['Adverbial', s.adverbials.map(sp => txt(sp)).join(' · '), 'adverbial']);
  }
  if (STATE.grammar.length) {
    rows.push(['Tense', STATE.grammar.map(g => g.name).join(' / '),
      STATE.grammar.length === 1 ? STATE.grammar[0].glossId : null]);
  }
  const isQ = tokens.some(t => t.text === '?');
  const isImp = !s.subject && s.vp && s.vp.start === 0;
  const type = isQ ? 'Interrogative (tanya)' : isImp ? 'Imperative' : 'Declarative';
  rows.push(['Sentence type', type, isQ ? 'interrogative' : null]);

  el.innerHTML = `<h3>Ringkasan Struktur</h3>` +
    `<dl class="kv">${rows.map(([k,v,gid]) =>
      `<dt>${gid ? glossLink(gid, k) : esc(k)}</dt><dd>${esc(v||'—')}</dd>`).join('')}</dl>`;
}

function renderDetail() {
  const el = document.getElementById('detail');
  if (STATE.selected == null) {
    el.innerHTML = `<h3>Detail</h3><div class="muted">Klik sebuah kata atau frasa.</div>`;
    return;
  }
  const idx = STATE.selected;
  const info = explainWord(idx, STATE.tokens, STATE.spans, STATE.structure);
  const wf = wordFunction(idx, STATE.tokens, STATE.spans, STATE.structure);

  const tagGloss = TAG_TO_GLOSSARY[info.tag];
  const tenseGloss = wf.tense ? wf.tense.glossId : null;

  let html = `<h3>Detail Kata</h3>`;
  html += `<dl class="kv">`;
  html += `<dt>Kata</dt><dd><strong>${esc(info.text)}</strong></dd>`;
  html += `<dt>Part of speech</dt><dd>${tagGloss ? glossLink(tagGloss, info.label) : esc(info.label)}</dd>`;
  if (info.lemma) html += `<dt>Lemma</dt><dd>${esc(info.lemma)}</dd>`;
  if (info.form)  html += `<dt>Verb form</dt><dd>${glossLink(FORM_TO_GLOSSARY[info.form] || null, info.form)}</dd>`;
  if (info.aux)   html += `<dt>Peran</dt><dd>${glossLink('auxiliary-verb', 'Auxiliary verb')}</dd>`;
  if (wf.phraseRole) html += `<dt>Fungsi</dt><dd>${glossLink(wf.phraseGloss, wf.phraseRole)}</dd>`;
  if (wf.tense) html += `<dt>Tense</dt><dd>${glossLink(tenseGloss, wf.tense.name)} — <code>${esc(wf.tense.formula)}</code></dd>`;
  html += `</dl>`;
  html += `<p class="expl">${esc(info.reason)}</p>`;

  if (wf.span) {
    const pg = PHRASE_TO_GLOSSARY[wf.span.type];
    html += `<p class="expl"><strong>Frasa:</strong> ${pg ? glossLink(pg, wf.span.label) : esc(wf.span.label)} (kata ${wf.span.start+1}–${wf.span.end+1})</p>`;
  }
  if (info.ambiguous && info.ambiguous.length) {
    html += `<p class="expl"><strong>Ambigu:</strong> kemungkinan lain: ${info.ambiguous.join(', ')}.</p>`;
  }
  el.innerHTML = html;
}

function renderValidation() {
  const el = document.getElementById('validation');
  if (!STATE.issues.length) { el.innerHTML = `<h3>Grammar Check</h3><div class="muted">—</div>`; return; }
  const items = STATE.issues;
  const renderItem = (i) => {
    const glossBtn = i.glossId
      ? ` <button type="button" class="gloss-link" data-gloss="${esc(i.glossId)}" style="font-size:11.5px">Pelajari aturan</button>`
      : '';
    return `<div class="issue ${i.level}">${esc(i.msg)}${glossBtn}</div>`;
  };
  const header = `<h3>Grammar Check</h3>`;
  renderExpandable('validation', items, renderItem, 3);
  // Tambahkan heading hanya jika belum ada — renderExpandable mengganti innerHTML
  const el2 = document.getElementById('validation');
  el2.innerHTML = header + el2.innerHTML;
}

function renderPatterns() {
  const el = document.getElementById('patterns');
  if (!STATE.grammar.length) {
    el.innerHTML = `<h3>Pola Grammar Terdeteksi</h3><div class="muted">Tidak ada pola yang teridentifikasi dengan pasti.</div>`;
    return;
  }
  const items = STATE.grammar;
  const renderItem = (g) => {
    const span = STATE.tokens.slice(g.span.start, g.span.end + 1).map(t=>t.text).join(' ');
    const title = g.glossId
      ? `<button type="button" class="gloss-link" data-gloss="${esc(g.glossId)}" style="font-weight:600;font-size:14px">${esc(g.name)}</button>`
      : `<strong>${esc(g.name)}</strong>`;
    return `<div class="issue info">
      ${title} — <code>${esc(g.formula)}</code><br>
      <span class="muted">Kata yang mengisi: ${esc(span)}</span>
    </div>`;
  };
  renderExpandable('patterns', items, renderItem, 3);
  document.getElementById('patterns').innerHTML =
    `<h3>Pola Grammar Terdeteksi</h3>` + document.getElementById('patterns').innerHTML;
}

function render() {
  renderSentence();
  renderLegend();
  renderSummary();
  renderDetail();
  renderValidation();
  renderPatterns();
}

function analyze() {
  const text = document.getElementById('input').value;
  const tokens = tokenize(text);
  tagAll(tokens);
  const spans = chunk(tokens);
  const structure = analyzeStructure(tokens, spans);
  const grammar = detectGrammar(tokens, spans);
  structure.grammar = grammar;
  const issues = validate(tokens, structure);

  STATE.tokens = tokens;
  STATE.spans = spans;
  STATE.structure = structure;
  STATE.grammar = grammar;
  STATE.issues = issues;
  STATE.selected = null;

  render();
  autoResizeInput();
}

